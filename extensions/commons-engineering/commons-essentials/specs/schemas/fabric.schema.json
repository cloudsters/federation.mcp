{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fabric.schema.json",
  "title": "Commons FABRIC: fabric/systems.yml, and in $defs a reading",
  "type": "object",
  "required": [
    "systems"
  ],
  "additionalProperties": false,
  "properties": {
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "holder",
          "access",
          "class",
          "queries"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "an open word: ledger, booking, roster, sensor, crm"
          },
          "holder": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "string",
            "minLength": 1,
            "description": "a reference to where the commons keeps the access, never the secret"
          },
          "class": {
            "type": "string",
            "minLength": 1
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "about",
                "yields"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "about": {
                  "$ref": "#/$defs/address"
                },
                "yields": {
                  "$ref": "#/$defs/yields"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "yields": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "measure",
            "unit"
          ],
          "additionalProperties": false,
          "properties": {
            "measure": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "signal"
          ],
          "additionalProperties": false,
          "properties": {
            "signal": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "reading": {
      "type": "object",
      "required": [
        "id",
        "system",
        "query",
        "read_at",
        "as",
        "about"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^reading:[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "system": {
          "$ref": "#/$defs/id"
        },
        "query": {
          "$ref": "#/$defs/id"
        },
        "read_at": {
          "type": "string",
          "minLength": 1
        },
        "as": {
          "type": "string",
          "minLength": 1
        },
        "about": {
          "$ref": "#/$defs/target"
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "value",
                "unit",
                "period"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "period": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "signal"
              ],
              "additionalProperties": false,
              "properties": {
                "signal": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "withdrawn": {
          "type": "object",
          "required": [
            "at",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "withdrawn"
            ]
          }
        },
        {
          "required": [
            "withdrawn"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "kind",
        "slug"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "address": {
      "type": "object",
      "required": [
        "from",
        "to",
        "weight",
        "status",
        "source"
      ],
      "additionalProperties": false,
      "description": "MODEL's address (model R18, $defs/address): a query refers to the model from outside it",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "$ref": "#/$defs/target"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "proposed",
            "ratified",
            "rejected"
          ]
        },
        "source": {
          "enum": [
            "machine",
            "curated",
            "human"
          ]
        }
      }
    }
  }
}
